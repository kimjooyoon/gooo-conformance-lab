package problemresolution
namespace problemresolution

entity Problem id "domain://entity/problem"
entity Resolution id "domain://entity/resolution"
entity Decision id "domain://entity/decision"

activity DescribeProblem(Problem) -> Problem computes "domain.describe:problem"
activity ProposeResolution(Problem) -> Resolution computes "domain.propose:resolution"
activity RecordDecision(Resolution) -> Decision computes "domain.record:decision"
